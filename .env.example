# Env-driven config (spec 00 / 07). Same artifact across hosts; only this file changes.
# Copy to .env and fill in. NEVER commit .env.
# Keep comments on their OWN lines. Inline comments after a value are tolerated only
# when preceded by whitespace; quote any value that legitimately contains '#'.

# --- Runtime ---
# TBOT_ENV: dev | demo | trial | challenge | funded
TBOT_ENV=dev
TBOT_STATE_DIR=./state
TBOT_CONFIG_FILE=./config/default.yaml

# --- MT5 (live host only; Windows) ---
# Account number (digits only)
TBOT_MT5_LOGIN=
# Quote the password if it contains spaces or '#'
TBOT_MT5_PASSWORD=
# Exact server name from the MT5 login dialog, e.g. FTMO-Demo2
TBOT_MT5_SERVER=
# Absolute path to the SPECIFIC broker's terminal64.exe (you have several installed)
TBOT_MT5_TERMINAL_PATH=

# --- Account envelope (FTMO) ---
# Initial balance; sets the 5% daily / 10% overall floors
TBOT_ACCOUNT_INITIAL=100000
TBOT_ACCOUNT_CURRENCY=USD

# --- Alerting (ops, spec 07) ---
TBOT_TELEGRAM_BOT_TOKEN=
TBOT_TELEGRAM_CHAT_ID=
TBOT_HEALTHCHECKS_URL=
